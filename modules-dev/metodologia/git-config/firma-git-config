# sops-git-config
# Git filter configuration for automatic SOPS encryption/decryption

[filter "sops-yaml"]
    clean    = sops-clean.sh yaml
    smudge   = sops-smudge.sh yaml
    required = true

[filter "sops-dotenv"]
    clean    = sops-clean.sh dotenv
    smudge   = sops-smudge.sh dotenv
    required = true

[diff "sops"]
    textconv = sh -c 'sops --decrypt \"$0\" 2>/dev/null || cat \"$0\"'
